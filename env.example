# Copier vers .env et remplir (ne pas versionner .env).
# Ne jamais mettre de vraie clé dans env.example.
#
# --- Choisir le fournisseur LLM ---
# LLM_PROVIDER=cohere
# LLM_PROVIDER=openai
# LLM_PROVIDER=auto
#
# --- Cohere (https://dashboard.cohere.com ) ---
COHERE_API_KEY=
# Modèle : utiliser un nom actuel (les anciens « command-r-plus » sans date sont retirés par Cohere).
# Exemples : command-r-08-2024 | command-r-plus-08-2024 | command-a-03-2025
# Liste : https://docs.cohere.com/docs/models
COHERE_MODEL=command-r-08-2024
# COHERE_BASE_URL=
#
# --- Commun ---
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048
# Délai par appel (secondes) ; relever si « read operation timed out » (ex. 300).
# LLM_TIMEOUT=240
# Nouvelles tentatives en cas de timeout / 5xx (Cohere uniquement).
# LLM_MAX_RETRIES=3
# LLM_MOCK=1
#
# --- Corpus vs web (priorité dataset, sinon fallback) ---
# CORPUS_MIN_TOP_SCORE=0.26
# CORPUS_MIN_TERM_RATIO=0.5
#
# --- Latence (profil rapide recommandé en dev) ---
# COHERE_MODEL=command-r-08-2024
# QUERY_REWRITE_LLM=0
# RERANK_ENABLE_CROSS_ENCODER=0
# WEB_FALLBACK_MAX_SEARCH_QUERIES=2
# RAG_PRELOAD=1
# RAG_RETRIEVAL_POOL_CAP=48
#
# --- Reranking (TRÈS IMPORTANT pour la pertinence) ---
# Hybride recommandé : FAISS + BM25 + mots-clés.
# Activer le cross-encoder si vous voulez une pertinence maximale (plus lent au 1er chargement).
# Avec CE=1 : le rerank ne score le CE que sur les RERANK_CE_MAX_CANDIDATES premiers (défaut 24).
# RERANK_ENABLE_CROSS_ENCODER=0
# RERANK_CE_MAX_CANDIDATES=24
# RERANK_CE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Plafond candidats FAISS (0 = auto 64 si CE actif, sinon pas de plafond auto)
# RAG_RETRIEVAL_POOL_CAP=64
# Alternative plus forte (plus lourde): BAAI/bge-reranker-base
# RERANK_SEMANTIC_WEIGHT=0.40
# RERANK_BM25_WEIGHT=0.35
# RERANK_KEYWORD_WEIGHT=0.25
# Si CE activé, ce poids est pris en compte.
# RERANK_CE_WEIGHT=0.35
# Limite de texte candidate envoyée au CE (latence/mémoire)
# RERANK_CE_TEXT_MAX_CHARS=1600
#
# --- Métadonnées enrichies des chunks ---
# Le script merge ajoute automatiquement:
# bo_number, law_date, document_type, ministry, category, language
# Après modification du schéma, regénérer:
# 1) python scripts/merge_chunks.py
# 2) python scripts/build_embeddings.py
# 3) python scripts/build_faiss.py
#
# --- Compréhension de requête (80 % corpus / 20 % LLM) ---
# Par défaut : analyse par règles (query_understanding) + FAISS + rerank.
# QUERY_REWRITE_LLM=1 : réécriture LLM avant recherche pour questions ambiguës (~20 %).
# QUERY_REWRITE_LLM_THRESHOLD=0.52  (plus bas = plus de passages LLM)
# Nécessite COHERE_API_KEY (ou OpenAI) — désactivé si LLM_MOCK=1.
# QUERY_REWRITE_LLM=1
# QUERY_REWRITE_LLM_THRESHOLD=0.52
#
# --- Web fallback intelligent ---
# Fallback web contrôlé (défaut strict = domaines officiels .ma)
# Se déclenche si le corpus ne couvre pas la procédure (ex. CNIE : le BO cite la CNIE
# hors sujet → bascule vers maroc.ma / mre.gov.ma / cnie.ma via recherche web).
# WEB_FALLBACK_OFFICIAL_ONLY=1
# WEB_FALLBACK_ALLOW_MA_BROAD=1
# WEB_FALLBACK_USE_DDGS=1
# WEB_FALLBACK_USE_DDG_HTML=0
# WEB_FALLBACK_MAX_SEARCH_QUERIES=3
# WEB_FALLBACK_MAX_RESULTS=5
# WEB_FALLBACK_MIN_OVERLAP=0.05
# 1 = curated + dataset JSONL avant DuckDuckGo (plus rapide, évite 403 consulat.ma)
# WEB_FALLBACK_CURATED_FIRST=1
#
# Portails CNIE / Watiqa / passeport : si le corpus local n'a pas une vraie procédure
# (menu vide, mauvais portail, BO hors sujet), le fallback web se déclenche automatiquement
# au lieu d'une réponse inutile. Textes de secours (curated) seulement si le web échoue.
#
# --- Ingestion file web → corpus (semi-automatique) ---
# Le fallback web remplit data/processed/web_additions_queue.jsonl à chaque utilisation.
# Intégration batch (recommandé 1×/semaine ou après une session de tests) :
#   python scripts/ingest_web_queue.py --apply --prune-queue --rebuild
# WEB_INGEST_MIN_TEXT_LEN=120
#
# --- OpenAI ou compatible ---
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# --- Plateforme web ---
# WEBAPP_SECRET_KEY=changez-moi-en-production-long-et-aleatoire
# WEBAPP_ALLOW_REGISTER=0
# 1 = affiche l’indice compte démo (demo / demo123) sur la page de connexion.
# WEBAPP_SHOW_DEMO_LOGIN=0
# Comptes en base : PostgreSQL si défini, sinon SQLite (data/webapp_users.db)
# WEBAPP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_maroc2
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_maroc2
# Utilisateurs autorisés sur /admin et /api/metrics/summary (virgules)
# WEBAPP_ADMIN_USERS=demo
#
# --- KPI production (article IEEE) ---
# KPI_SOURCED_MIN_PCT=85
# KPI_FALLBACK_MAX_PCT=15
#
# --- Rebuild corpus + index (aligné article) ---
# python scripts/rebuild_corpus_and_index.py
# python scripts/evaluate_hit_at_k.py
# pytest tests/ -q
#
# --- Évaluation RAGAS (qualité génération : faithfulness, answer relevancy) ---
# Le juge RAGAS est distinct du LLM chat (plusieurs appels / question → coût API).
# Avec Cohere seul (défaut si OPENAI absent) :
#   python scripts/evaluate_ragas.py --limit 5
# Avec OpenAI comme juge (recommandé pour context_relevance) :
#   RAGAS_JUDGE_PROVIDER=openai OPENAI_API_KEY=sk-... python scripts/evaluate_ragas.py --limit 5
# RAGAS_JUDGE_PROVIDER=auto|cohere|openai
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# RAGAS_EMBED_MODEL=text-embedding-3-small
# Ne pas utiliser LLM_MOCK=1 pour des scores représentatifs.
